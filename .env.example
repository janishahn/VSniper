# Docker Compose host ports for the app and the noVNC browser viewer (both loopback-only).
VSNIPER_PORT=8010
VSNIPER_VNC_PORT=6080

# DEBUG adds every OpenAI request and response (images shortened) and each decision's answers.
LOG_LEVEL=INFO

# Vinted
VINTED_REGION=de
VINTED_COOKIE=put-your-vinted-cookie-here
# Add-by-URL imports use a persistent visible Chromium session. A home connection needs
# no proxy; on a datacenter IP use a sticky residential one so solved clearance keeps its IP.
VINTED_BROWSER_PROXY_URL=
VINTED_BROWSER_TIMEOUT_SECONDS=30

# Telegram
TELEGRAM_BOT_TOKEN=put-your-telegram-bot-token-here
TELEGRAM_CHAT_ID=put-your-telegram-chat-id-here

# OpenAI
# The vision model describes reference photos, writes the taste profile and explains alerts.
# The decision model decides through the Decisions API whether each listing is worth an alert.
OPENAI_API_KEY=put-your-openai-api-key-here
OPENAI_VISION_MODEL=gpt-6.1-terra
OPENAI_DECISION_MODEL=gpt-6-luna

# Worker
WORKER_MAX_CONCURRENCY=4
# Seed/fallback only — once the app has run once, edit the scan interval on the Settings
# page instead; that value (stored in the DB) is what the worker actually polls each cycle.
SCAN_INTERVAL_SECONDS=1800
# Retention: the worker prunes rows older than these windows (in days). Generous by default;
# pending/processing Telegram deliveries are never pruned regardless of age.
CANDIDATE_RETENTION_DAYS=365
DELIVERY_RETENTION_DAYS=365
AI_USAGE_RETENTION_DAYS=365
ERROR_RETENTION_DAYS=365
# How often (in maintenance passes) the prune job runs. Maintenance runs on its own fixed
# ~60s cadence independent of the scan interval, so 60 cycles is still ~hourly.
PRUNE_EVERY_CYCLES=60
